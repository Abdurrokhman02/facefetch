// https://theindiandev.in/

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "type": "kitty-icat",
		"height": 12,
		"width": 22
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "|| aB ||",
      "keyColor": "red"
    },
    "break",
    {
      "type": "custom",
      // "key": "  Powewed by Awch Winux (≧◡≦)",
      "key": "  I use Arch btw ദ്ദി(⎚_⎚)",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "dim_"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "yellow",
      "format": "{}"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "cyan",
      "format": "{name:-28}" 
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "green",
      "format": "{used} of 16 GiB [{percentage}]"
    },
    // {
    //   "type": "disk",
    //   "key": " ",
    //   "keyColor": "blue",
    //   "folders": "/",
    //   "format": "{size-used} / {size-total} ({size-percentage})"
    // },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
  ],
}
